+package dev.jason.gboardpatches.extension.iosbottomrow;
+
+import android.content.Context;
+import android.util.Log;
+
+import java.util.Collections;
+
+import dev.jason.gboardpatches.extension.R;
+import dev.jason.gboardpatches.extension.settings.GboardPatchesFeatureAvailability;
+import dev.jason.gboardpatches.extension.settings.GboardPatchesSettingsContract;
+import dev.jason.gboardpatches.extension.settings.GboardSettingsText;
+
+public final class GboardIosBottomRowSettingsFeature
+        implements GboardPatchesSettingsContract.Feature {
+    private static final String TAG = "GboardPatches";
+    private final String title;
+    private final String summary;
+    private final String badge;
+    private final String sectionTitle;
+    private final String toggleTitle;
+    private final String toggleSummary;
+
+    public GboardIosBottomRowSettingsFeature(Context context) {
+        title = GboardSettingsText.get(context, R.string.gboard_patches_ios_bottom_row_title);
+        summary = GboardSettingsText.get(context, R.string.gboard_patches_ios_bottom_row_summary);
+        badge = GboardSettingsText.get(context, R.string.gboard_patches_header_badge);
+        sectionTitle = GboardSettingsText.get(context, R.string.gboard_patches_ios_bottom_row_section);
+        toggleTitle = GboardSettingsText.get(context, R.string.gboard_patches_ios_bottom_row_enabled_title);
+        toggleSummary = GboardSettingsText.get(context, R.string.gboard_patches_ios_bottom_row_enabled_summary);
+    }
+
+    @Override public String getEntryTitle() { return title; }
+    @Override public String getEntrySummary() { return summary; }
+
+    @Override public boolean isAvailable(Context context) {
+        return GboardPatchesFeatureAvailability.hasFeature(
+                context, GboardPatchesFeatureAvailability.FEATURE_IOS_BOTTOM_ROW);
+    }
+
+    @Override public GboardPatchesSettingsContract.Screen buildScreen(
+            GboardPatchesSettingsContract.FeatureHost host) {
+        if (host == null || host.getContext() == null) {
+            return new GboardPatchesSettingsContract.Screen(
+                    title, badge, title, summary, Collections.emptyList());
+        }
+        Context context = host.getContext();
+        boolean enabled = GboardIosBottomRowSettings.isEnabled(context);
+        GboardPatchesSettingsContract.ToggleRow row = new GboardPatchesSettingsContract.ToggleRow(
+                toggleTitle, toggleSummary, true, enabled, value -> {
+                    if (!GboardIosBottomRowSettings.setEnabled(context, value)) {
+                        Log.w(TAG, "Could not save iOS bottom-row setting");
+                    }
+                    GboardPatchesSettingsContract.refresh(host);
+                });
+        return new GboardPatchesSettingsContract.Screen(
+                title, badge, title, summary, Collections.emptyList(),
+                Collections.singletonList(new GboardPatchesSettingsContract.Section(
+                        sectionTitle, Collections.singletonList(row))),
+                GboardPatchesSettingsContract.RefreshPolicy.none(),
+                GboardPatchesSettingsContract.PanelStyle.FLAT);
+    }
+}

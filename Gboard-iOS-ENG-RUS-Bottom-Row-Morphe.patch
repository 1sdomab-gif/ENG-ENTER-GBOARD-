@@ -0,0 +1,34 @@
+package dev.jason.gboardpatches.extension.iosbottomrow;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+/** Preferences owned only by the independent iOS-style bottom-row feature. */
+public final class GboardIosBottomRowSettings {
+    private static final String PREF_FILE = "gboard_ios_bottom_row_settings";
+    private static final String PREF_ENABLED = "ios_bottom_row_enabled";
+    private static final boolean DEFAULT_ENABLED = false;
+
+    private GboardIosBottomRowSettings() { }
+
+    public static SharedPreferences preferences(Context context) {
+        if (context == null) return null;
+        Context app = context.getApplicationContext();
+        return (app != null ? app : context).getSharedPreferences(PREF_FILE, Context.MODE_PRIVATE);
+    }
+
+    public static boolean isEnabled(Context context) {
+        SharedPreferences prefs = preferences(context);
+        if (prefs == null) return DEFAULT_ENABLED;
+        try {
+            return prefs.getBoolean(PREF_ENABLED, DEFAULT_ENABLED);
+        } catch (ClassCastException ignored) {
+            return DEFAULT_ENABLED;
+        }
+    }
+
+    public static boolean setEnabled(Context context, boolean enabled) {
+        SharedPreferences prefs = preferences(context);
+        return prefs != null && prefs.edit().putBoolean(PREF_ENABLED, enabled).commit();
+    }
+}

+package dev.jason.gboardpatches.extension.iosbottomrow;
+
+import android.content.Context;
+import android.content.ContextWrapper;
+import android.inputmethodservice.InputMethodService;
+import android.text.InputType;
+import android.util.Log;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.ViewParent;
+import android.view.inputmethod.EditorInfo;
+import android.view.inputmethod.InputMethodSubtype;
+import android.view.inputmethod.InputMethodManager;
+import android.widget.LinearLayout;
+
+import java.util.Locale;
+import java.util.Map;
+import java.util.WeakHashMap;
+
+/**
+ * Independent iOS-style bottom-row runtime. It owns its preferences and does not call or
+ * modify any other feature runtime. It changes weights only on the ordinary Latin footer.
+ */
+@SuppressWarnings("unused")
+public final class GboardIosBottomRowRuntime {
+    private static final String TAG = "GboardIosBottomRow";
+    private static final String KEYBOARD_ROOT_CLASS =
+            "com.google.android.libraries.inputmethod.widgets.SoftKeyboardView";
+    private static final String SWITCH_TO_SYMBOL_SLOT = "key_pos_switch_to_symbol";
+    private static final String SWITCH_TO_ALPHA_SLOT = "key_pos_switch_to_alpha";
+    private static final String[] SLOT_NAMES = {
+            SWITCH_TO_SYMBOL_SLOT, "A02", "key_pos_switch_to_next_language",
+            "key_pos_space", "A06", "key_pos_del", "key_pos_ime_action"
+    };
+    private static final Map<View, Float> ORIGINAL_WEIGHTS = new WeakHashMap<>();
+
+    private GboardIosBottomRowRuntime() { }
+
+    public static void afterSoftKeyBound(Object receiver) {
+        if (!(receiver instanceof View keyView)) return;
+        try {
+            Footer footer = findFooter(keyView);
+            if (footer == null) return;
+
+            InputMethodService service = findInputMethodService(keyView.getContext());
+            boolean enabled = GboardIosBottomRowSettings.isEnabled(keyView.getContext());
+            EditorInfo editor = service == null ? null : service.getCurrentInputEditorInfo();
+            InputMethodManager inputMethodManager = (InputMethodManager) keyView.getContext()
+                    .getSystemService(Context.INPUT_METHOD_SERVICE);
+            InputMethodSubtype subtype = inputMethodManager == null
+                    ? null : inputMethodManager.getCurrentInputMethodSubtype();
+            boolean eligible = enabled && isEnglishOrRussian(subtype) && isEligibleEditor(editor);
+            if (!eligible) {
+                restoreOriginalWeights(footer);
+                return;
+            }
+
+            boolean uri = isUriEditor(editor);
+            // Relative weights: ?123/ABC=2, comma=1, globe=1, space=3, period=1,
+            // delete=1, Enter=2 (URI Enter=1.5). Cluster weights equal their children.
+            float enterWeight = uri ? 150f : 200f;
+            View[] targets = {
+                    footer.slots[0], footer.slots[1], footer.middle,
+                    footer.slots[2], footer.spaceCluster, footer.slots[3],
+                    footer.slots[4], footer.slots[5], footer.slots[6]
+            };
+            float[] weights = { 200f, 100f, 500f, 100f, 400f, 300f, 100f, 100f, enterWeight };
+            if (applyWeights(targets, weights)) {
+                footer.root.requestLayout();
+                footer.middle.requestLayout();
+                footer.spaceCluster.requestLayout();
+            }
+        } catch (Throwable error) {
+            Log.w(TAG, "Could not apply independent iOS-style bottom-row weights", error);
+        }
+    }
+
+    private static InputMethodService findInputMethodService(Context context) {
+        Context current = context;
+        for (int depth = 0; current != null && depth < 12; depth++) {
+            if (current instanceof InputMethodService service) return service;
+            if (!(current instanceof ContextWrapper wrapper)) break;
+            Context next = wrapper.getBaseContext();
+            if (next == current) break;
+            current = next;
+        }
+        return null;
+    }
+
+    private static boolean isEnglishOrRussian(InputMethodSubtype subtype) {
+        if (subtype == null) return false;
+        String mode = subtype.getMode();
+        if (mode != null && !mode.isEmpty() && !"keyboard".equalsIgnoreCase(mode)) return false;
+        String localeTag = subtype.getLocale();
+        if (localeTag == null || localeTag.isEmpty()) return false;
+        Locale locale = Locale.forLanguageTag(localeTag.replace('_', '-'));
+        String language = locale.getLanguage();
+        return "en".equalsIgnoreCase(language) || "ru".equalsIgnoreCase(language);
+    }
+
+    private static boolean isEligibleEditor(EditorInfo editor) {
+        if (editor == null) return false;
+        int inputClass = editor.inputType & InputType.TYPE_MASK_CLASS;
+        if (inputClass != InputType.TYPE_CLASS_TEXT) return false;
+        int variation = editor.inputType & InputType.TYPE_MASK_VARIATION;
+        return variation == InputType.TYPE_TEXT_VARIATION_NORMAL
+                || variation == InputType.TYPE_TEXT_VARIATION_URI
+                || variation == InputType.TYPE_TEXT_VARIATION_WEB_EDIT_TEXT;
+    }
+
+    private static boolean isUriEditor(EditorInfo editor) {
+        if (editor == null) return false;
+        int variation = editor.inputType & InputType.TYPE_MASK_VARIATION;
+        return variation == InputType.TYPE_TEXT_VARIATION_URI
+                || variation == InputType.TYPE_TEXT_VARIATION_WEB_EDIT_TEXT;
+    }
+
+    private static Footer findFooter(View keyView) {
+        // Never search arbitrary ancestors: only inspect a footer inside Gboard's keyboard root.
+        // The exact slot IDs and nested structure below further limit this to the ordinary Latin row.
+        ViewGroup root = findKeyboardRoot(keyView);
+        return root == null ? null : findFooterInTree(root);
+    }
+
+    private static ViewGroup findKeyboardRoot(View view) {
+        ViewParent parent = view == null ? null : view.getParent();
+        while (parent instanceof ViewGroup group) {
+            if (KEYBOARD_ROOT_CLASS.equals(group.getClass().getName())
+                    || "SoftKeyboardView".equals(group.getClass().getSimpleName())) return group;
+            parent = group.getParent();
+        }
+        return null;
+    }
+
+    private static Footer findFooterInTree(View view) {
+        if (!(view instanceof ViewGroup group)) return null;
+        Footer here = buildFooter(group);
+        if (here != null) return here;
+        for (int i = 0; i < group.getChildCount(); i++) {
+            Footer nested = findFooterInTree(group.getChildAt(i));
+            if (nested != null) return nested;
+        }
+        return null;
+    }
+
+    private static Footer buildFooter(ViewGroup root) {
+        if (root.getChildCount() != 5) return null;
+        View switchKey = root.getChildAt(0);
+        View comma = root.getChildAt(1);
+        View middleView = root.getChildAt(2);
+        View delete = root.getChildAt(3);
+        View enter = root.getChildAt(4);
+        // The same dedicated policy covers both sides of the normal Latin symbol toggle:
+        // ?123 while typing letters and ABC/АБВ while viewing the ordinary symbols page.
+        if (!isSwitchKey(switchKey) || !hasSlot(comma, SLOT_NAMES[1])
+                || !hasSlot(delete, SLOT_NAMES[5]) || !hasSlot(enter, SLOT_NAMES[6])) return null;
+        if (!(middleView instanceof ViewGroup middle) || middle.getChildCount() != 2) return null;
+        View globe = middle.getChildAt(0);
+        View spaceView = middle.getChildAt(1);
+        if (!hasSlot(globe, SLOT_NAMES[2]) || !(spaceView instanceof ViewGroup spaceCluster)
+                || spaceCluster.getChildCount() != 2) return null;
+        View space = spaceCluster.getChildAt(0);
+        View period = spaceCluster.getChildAt(1);
+        if (!hasSlot(space, SLOT_NAMES[3]) || !hasSlot(period, SLOT_NAMES[4])) return null;
+        return new Footer(root, middle, spaceCluster,
+                new View[] { switchKey, comma, globe, space, period, delete, enter });
+    }
+
+    private static boolean isSwitchKey(View view) {
+        return hasSlot(view, SWITCH_TO_SYMBOL_SLOT) || hasSlot(view, SWITCH_TO_ALPHA_SLOT);
+    }
+
+    private static boolean hasSlot(View view, String expected) {
+        if (view == null || view.getId() == View.NO_ID) return false;
+        try {
+            return expected.equals(view.getResources().getResourceEntryName(view.getId()));
+        } catch (Throwable ignored) {
+            return false;
+        }
+    }
+
+    private static boolean applyWeights(View[] views, float[] weights) {
+        LinearLayout.LayoutParams[] params = resolveParams(views);
+        if (params == null) return false;
+        synchronized (ORIGINAL_WEIGHTS) {
+            for (int i = 0; i < views.length; i++) ORIGINAL_WEIGHTS.putIfAbsent(views[i], params[i].weight);
+        }
+        boolean changed = false;
+        for (int i = 0; i < views.length; i++) {
+            if (Float.compare(params[i].weight, weights[i]) != 0) {
+                params[i].weight = weights[i];
+                views[i].setLayoutParams(params[i]);
+                changed = true;
+            }
+        }
+        return changed;
+    }
+
+    private static void restoreOriginalWeights(Footer footer) {
+        View[] views = { footer.slots[0], footer.slots[1], footer.middle,
+                footer.slots[2], footer.spaceCluster, footer.slots[3], footer.slots[4],
+                footer.slots[5], footer.slots[6] };
+        boolean changed = false;
+        synchronized (ORIGINAL_WEIGHTS) {
+            for (View view : views) {
+                Float original = ORIGINAL_WEIGHTS.remove(view);
+                if (original == null) continue;
+                ViewGroup.LayoutParams raw = view.getLayoutParams();
+                if (raw instanceof LinearLayout.LayoutParams params
+                        && Float.compare(params.weight, original) != 0) {
+                    params.weight = original;
+                    view.setLayoutParams(params);
+                    changed = true;
+                }
+            }
+        }
+        if (changed) {
+            footer.root.requestLayout();
+            footer.middle.requestLayout();
+            footer.spaceCluster.requestLayout();
+        }
+    }
+
+    private static LinearLayout.LayoutParams[] resolveParams(View[] views) {
+        LinearLayout.LayoutParams[] result = new LinearLayout.LayoutParams[views.length];
+        for (int i = 0; i < views.length; i++) {
+            if (views[i] == null || !(views[i].getLayoutParams() instanceof LinearLayout.LayoutParams params)) {
+                return null;
+            }
+            result[i] = params;
+        }
+        return result;
+    }
+
+    private static final class Footer {
+        final ViewGroup root;
+        final ViewGroup middle;
+        final ViewGroup spaceCluster;
+        final View[] slots;
+        Footer(ViewGroup root, ViewGroup middle, ViewGroup spaceCluster, View[] slots) {
+            this.root = root;
+            this.middle = middle;
+            this.spaceCluster = spaceCluster;
+            this.slots = slots;
+        }
+    }
+}
